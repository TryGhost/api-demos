{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>TryGhost/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.html$/"
      ],
      "matchStrings": [
        "https://unpkg\\.com/(?<depName>@tryghost/(?:content-api|helpers))@(?<currentValue>[^/\\s\"']+)/"
      ],
      "datasourceTemplate": "npm",
      "depTypeTemplate": "dependencies"
    }
  ],
  "customDatasources": {
    "ghost-node": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/TryGhost/Ghost/main/.nvmrc",
      "format": "plain"
    }
  },
  "packageRules": [
    {
      "description": "Follow the Node version selected by Ghost, including the tooling engine pin.",
      "matchManagers": [
        "nvm",
        "npm"
      ],
      "matchPackageNames": [
        "node"
      ],
      "overrideDatasource": "custom.ghost-node",
      "versioning": "node",
      "rangeStrategy": "replace",
      "groupName": "Ghost Node version"
    }
  ]
}
